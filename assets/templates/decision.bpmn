<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ComDecisao" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ComDecisao" isExecutable="false" name="Processo com decisão">
    <bpmn:startEvent id="Start_PedidoRecebido" name="Pedido recebido">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AnalisarPedido" name="Analisar pedido">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PedidoAprovado" name="Pedido aprovado?" default="Flow_4">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AtenderPedido" name="Atender pedido">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_InformarRecusa" name="Informar recusa">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PedidoEncerrado" name="Pedido encerrado">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_PedidoRecebido" targetRef="Task_AnalisarPedido" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_AnalisarPedido" targetRef="Gateway_PedidoAprovado" />
    <bpmn:sequenceFlow id="Flow_3" name="Sim" sourceRef="Gateway_PedidoAprovado" targetRef="Task_AtenderPedido">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pedidoAprovado == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4" name="Não" sourceRef="Gateway_PedidoAprovado" targetRef="Task_InformarRecusa" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_AtenderPedido" targetRef="End_PedidoEncerrado" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_InformarRecusa" targetRef="End_PedidoEncerrado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_ComDecisao">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_ComDecisao" bpmnElement="Process_ComDecisao">
      <bpmndi:BPMNShape id="Start_PedidoRecebido_di" bpmnElement="Start_PedidoRecebido">
        <omgdc:Bounds x="160" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AnalisarPedido_di" bpmnElement="Task_AnalisarPedido">
        <omgdc:Bounds x="310" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PedidoAprovado_di" bpmnElement="Gateway_PedidoAprovado">
        <omgdc:Bounds x="460" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InformarRecusa_di" bpmnElement="Task_InformarRecusa">
        <omgdc:Bounds x="610" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AtenderPedido_di" bpmnElement="Task_AtenderPedido">
        <omgdc:Bounds x="610" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PedidoEncerrado_di" bpmnElement="End_PedidoEncerrado">
        <omgdc:Bounds x="760" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="196" y="120" />
        <omgdi:waypoint x="310" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="410" y="120" />
        <omgdi:waypoint x="460" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="510" y="120" />
        <omgdi:waypoint x="560" y="120" />
        <omgdi:waypoint x="560" y="60" />
        <omgdi:waypoint x="610" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="510" y="120" />
        <omgdi:waypoint x="560" y="120" />
        <omgdi:waypoint x="560" y="180" />
        <omgdi:waypoint x="610" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="710" y="60" />
        <omgdi:waypoint x="735" y="60" />
        <omgdi:waypoint x="735" y="180" />
        <omgdi:waypoint x="760" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="710" y="180" />
        <omgdi:waypoint x="760" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>