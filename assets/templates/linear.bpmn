<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Linear" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Process_Linear" isExecutable="false" name="Processo linear">
    <bpmn:startEvent id="Start_DemandaRecebida" name="Demanda recebida">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegistrarDemanda" name="Registrar demanda">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ExecutarDemanda" name="Executar demanda">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EntregarResultado" name="Entregar resultado">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_DemandaConcluida" name="Demanda concluída">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_DemandaRecebida" targetRef="Task_RegistrarDemanda" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RegistrarDemanda" targetRef="Task_ExecutarDemanda" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ExecutarDemanda" targetRef="Task_EntregarResultado" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EntregarResultado" targetRef="End_DemandaConcluida" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Linear">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Linear" bpmnElement="Process_Linear">
      <bpmndi:BPMNShape id="Start_DemandaRecebida_di" bpmnElement="Start_DemandaRecebida">
        <omgdc:Bounds x="160" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarDemanda_di" bpmnElement="Task_RegistrarDemanda">
        <omgdc:Bounds x="310" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecutarDemanda_di" bpmnElement="Task_ExecutarDemanda">
        <omgdc:Bounds x="460" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EntregarResultado_di" bpmnElement="Task_EntregarResultado">
        <omgdc:Bounds x="610" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_DemandaConcluida_di" bpmnElement="End_DemandaConcluida">
        <omgdc:Bounds x="760" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="196" y="120" />
        <omgdi:waypoint x="310" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="410" y="120" />
        <omgdi:waypoint x="460" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="560" y="120" />
        <omgdi:waypoint x="610" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="710" y="120" />
        <omgdi:waypoint x="760" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>