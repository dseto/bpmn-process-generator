# ==============================================================================
# .gitignore - BPMN Process Generator Skill
# Garante que apenas o mínimo necessário para a skill seja versionado no Git.
# ==============================================================================

# Python bytecode e caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Testes locais e artefatos de teste
test-output*.html
tests/*.html

# Arquivos HTML gerados dinamicamente (preserva o editor central e o template)
*.html
!editor.html
!assets/bpmn-editor-template.html

# Configurações locais de IDEs e editores
.vscode/
.idea/
*.swp
*.swo

# Configurações locais de agentes e harness (gauntlet)
.claude/*
!.claude/harness/
.claude/harness/*.new

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# harness
.gauntlet/inbox/
.gauntlet/history/
.gauntlet/scorecard.json
.gauntlet/*.tmp
.claude/harness/debug.log
.claude/settings.local.json
