<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_BusBoarding" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BusBoarding" name="Fluxo de Embarque e Viagem de Ônibus" isExecutable="false">
    
    <bpmn:laneSet id="LaneSet_BusTrip">
      <bpmn:lane id="Lane_Passenger" name="Passageiro">
        <bpmn:flowNodeRef>Start_PassengerAtStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignalBus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BoardBus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentMethod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TapSmartCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FallbackCash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CashEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayWithCash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PassTurnstile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SeatAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SitInSeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TravelStanding</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergePosture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PressStopButton</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisembarkBus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TripCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_MissedBusFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LeftNoFunds</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Driver" name="Motorista">
        <bpmn:flowNodeRef>Task_CheckCapacity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsBusFull</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BypassStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ParkAtStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResumeRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StopAtDestination</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_FareCollector" name="Cobrador">
        <bpmn:flowNodeRef>Task_ReceiveCash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateAndReturnChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnableToGiveChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuthorizeTurnstileManual</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_BusSystem" name="Sistema do Ônibus">
        <bpmn:flowNodeRef>Task_OpenFrontDoors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateCardBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CardBalanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeductFare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AlertInsufficientBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TurnstileRelease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UnlockTurnstile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseDoors</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriggerStopIndicator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenRearDoors</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    
    <bpmn:startEvent id="Start_PassengerAtStop" name="Passageiro aguarda no ponto">
      <bpmn:outgoing>Flow_StartToSignal</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SignalBus" name="Dar sinal de parada para o ônibus">
      <bpmn:incoming>Flow_StartToSignal</bpmn:incoming>
      <bpmn:outgoing>Flow_SignalToCheck</bpmn:outgoing>
    </bpmn:userTask>

    
    <bpmn:userTask id="Task_CheckCapacity" name="Avaliar capacidade e lotação do veículo">
      <bpmn:incoming>Flow_SignalToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckToFullGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_IsBusFull" name="Ônibus com lotação máxima?">
      <bpmn:incoming>Flow_CheckToFullGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_BusFullYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_BusFullNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BypassStop" name="Sinalizar lotação e seguir viagem sem parar">
      <bpmn:incoming>Flow_BusFullYes</bpmn:incoming>
      <bpmn:outgoing>Flow_BypassToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_MissedBusFull" name="Passageiro aguarda o próximo ônibus">
      <bpmn:incoming>Flow_BypassToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ParkAtStop" name="Desacelerar e encostar o ônibus no ponto">
      <bpmn:incoming>Flow_BusFullNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ParkToOpenDoors</bpmn:outgoing>
    </bpmn:userTask>

    
    <bpmn:serviceTask id="Task_OpenFrontDoors" name="Abrir portas dianteiras de embarque">
      <bpmn:incoming>Flow_ParkToOpenDoors</bpmn:incoming>
      <bpmn:outgoing>Flow_DoorsToBoard</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_BoardBus" name="Subir os degraus e entrar no ônibus">
      <bpmn:incoming>Flow_DoorsToBoard</bpmn:incoming>
      <bpmn:outgoing>Flow_BoardToPayGateway</bpmn:outgoing>
    </bpmn:userTask>

    
    <bpmn:exclusiveGateway id="Gateway_PaymentMethod" name="Qual a forma de pagamento?">
      <bpmn:incoming>Flow_BoardToPayGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PayByCard</bpmn:outgoing>
      <bpmn:outgoing>Flow_PayByCash</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    
    <bpmn:userTask id="Task_TapSmartCard" name="Aproximar cartão de transporte no validador">
      <bpmn:incoming>Flow_PayByCard</bpmn:incoming>
      <bpmn:outgoing>Flow_TapToValidate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ValidateCardBalance" name="Ler chip e verificar saldo disponível">
      <bpmn:incoming>Flow_TapToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateToBalanceGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CardBalanceCheck" name="Saldo é suficiente?">
      <bpmn:incoming>Flow_ValidateToBalanceGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_BalanceSufficient</bpmn:outgoing>
      <bpmn:outgoing>Flow_BalanceInsufficient</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DeductFare" name="Debitar tarifa e registrar integração">
      <bpmn:incoming>Flow_BalanceSufficient</bpmn:incoming>
      <bpmn:outgoing>Flow_DeductToUnlock</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AlertInsufficientBalance" name="Emitir sinal sonoro de saldo insuficiente">
      <bpmn:incoming>Flow_BalanceInsufficient</bpmn:incoming>
      <bpmn:outgoing>Flow_AlertToFallback</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FallbackCash" name="Passageiro tem dinheiro em espécie?">
      <bpmn:incoming>Flow_AlertToFallback</bpmn:incoming>
      <bpmn:outgoing>Flow_HasFallbackCash</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoFallbackCash</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    
    <bpmn:exclusiveGateway id="Gateway_CashEntry" name="Pagamento em espécie">
      <bpmn:incoming>Flow_PayByCash</bpmn:incoming>
      <bpmn:incoming>Flow_HasFallbackCash</bpmn:incoming>
      <bpmn:outgoing>Flow_CashEntryToPay</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PayWithCash" name="Entregar notas/moedas ao cobrador">
      <bpmn:incoming>Flow_CashEntryToPay</bpmn:incoming>
      <bpmn:outgoing>Flow_PayToReceiveCash</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveCash" name="Conferir valor da tarifa recebida">
      <bpmn:incoming>Flow_PayToReceiveCash</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveToChangeGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_HasChange" name="Valor exato ou cobrador tem troco?">
      <bpmn:incoming>Flow_ReceiveToChangeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeAvailable</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChangeUnavailable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CalculateAndReturnChange" name="Calcular troco e devolver ao passageiro">
      <bpmn:incoming>Flow_ChangeAvailable</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeToAuthorize</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AuthorizeTurnstileManual" name="Pressionar botão de liberação da catraca">
      <bpmn:incoming>Flow_ChangeToAuthorize</bpmn:incoming>
      <bpmn:outgoing>Flow_AuthorizeToUnlock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UnableToGiveChange" name="Informar impossibilidade de troco e solicitar desembarque">
      <bpmn:incoming>Flow_ChangeUnavailable</bpmn:incoming>
      <bpmn:outgoing>Flow_NoChangeToEnd</bpmn:outgoing>
    </bpmn:userTask>

    
    <bpmn:endEvent id="End_LeftNoFunds" name="Passageiro desembarca sem pagar tarifa">
      <bpmn:incoming>Flow_NoFallbackCash</bpmn:incoming>
      <bpmn:incoming>Flow_NoChangeToEnd</bpmn:incoming>
    </bpmn:endEvent>

    
    <bpmn:exclusiveGateway id="Gateway_TurnstileRelease" name="Tarifa quitada">
      <bpmn:incoming>Flow_DeductToUnlock</bpmn:incoming>
      <bpmn:incoming>Flow_AuthorizeToUnlock</bpmn:incoming>
      <bpmn:outgoing>Flow_ReleaseToUnlock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UnlockTurnstile" name="Destravar catraca do ônibus">
      <bpmn:incoming>Flow_ReleaseToUnlock</bpmn:incoming>
      <bpmn:outgoing>Flow_UnlockToPass</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_PassTurnstile" name="Girar a catraca e acessar o salão de passageiros">
      <bpmn:incoming>Flow_UnlockToPass</bpmn:incoming>
      <bpmn:outgoing>Flow_PassToCloseDoors</bpmn:outgoing>
    </bpmn:userTask>

    
    <bpmn:serviceTask id="Task_CloseDoors" name="Fechar portas dianteiras">
      <bpmn:incoming>Flow_PassToCloseDoors</bpmn:incoming>
      <bpmn:outgoing>Flow_DoorsToResume</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ResumeRoute" name="Retomar viagem e acelerar no trânsito">
      <bpmn:incoming>Flow_DoorsToResume</bpmn:incoming>
      <bpmn:outgoing>Flow_ResumeToSeatCheck</bpmn:outgoing>
    </bpmn:userTask>

    
    <bpmn:exclusiveGateway id="Gateway_SeatAvailable" name="Há assento livre no veículo?">
      <bpmn:incoming>Flow_ResumeToSeatCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_SeatFreeYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_SeatFreeNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SitInSeat" name="Acomodar-se no assento vago">
      <bpmn:incoming>Flow_SeatFreeYes</bpmn:incoming>
      <bpmn:outgoing>Flow_SitToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TravelStanding" name="Permanecer em pé segurando firme no balaústre">
      <bpmn:incoming>Flow_SeatFreeNo</bpmn:incoming>
      <bpmn:outgoing>Flow_StandToMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergePosture" name="Sincronização de trajeto">
      <bpmn:incoming>Flow_SitToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_StandToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToPressButton</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    
    <bpmn:userTask id="Task_PressStopButton" name="Pressionar botão de sinal de parada antes do ponto">
      <bpmn:incoming>Flow_MergeToPressButton</bpmn:incoming>
      <bpmn:outgoing>Flow_ButtonToTrigger</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_TriggerStopIndicator" name="Acionar campainha e acender luminoso Parada Solicitada">
      <bpmn:incoming>Flow_ButtonToTrigger</bpmn:incoming>
      <bpmn:outgoing>Flow_TriggerToStop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_StopAtDestination" name="Parar no ponto de destino e acionar freio">
      <bpmn:incoming>Flow_TriggerToStop</bpmn:incoming>
      <bpmn:outgoing>Flow_StopToOpenRear</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_OpenRearDoors" name="Abrir portas traseiras de desembarque">
      <bpmn:incoming>Flow_StopToOpenRear</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenRearToDisembark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DisembarkBus" name="Descer pela porta traseira com segurança">
      <bpmn:incoming>Flow_OpenRearToDisembark</bpmn:incoming>
      <bpmn:outgoing>Flow_DisembarkToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_TripCompleted" name="Viagem concluída no destino com sucesso">
      <bpmn:incoming>Flow_DisembarkToEnd</bpmn:incoming>
    </bpmn:endEvent>

    
    <bpmn:sequenceFlow id="Flow_StartToSignal" sourceRef="Start_PassengerAtStop" targetRef="Task_SignalBus" />
    <bpmn:sequenceFlow id="Flow_SignalToCheck" sourceRef="Task_SignalBus" targetRef="Task_CheckCapacity" />
    <bpmn:sequenceFlow id="Flow_CheckToFullGateway" sourceRef="Task_CheckCapacity" targetRef="Gateway_IsBusFull" />
    
    <bpmn:sequenceFlow id="Flow_BusFullYes" name="Sim (Lotado)" sourceRef="Gateway_IsBusFull" targetRef="Task_BypassStop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isFull == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BypassToEnd" sourceRef="Task_BypassStop" targetRef="End_MissedBusFull" />
    
    <bpmn:sequenceFlow id="Flow_BusFullNo" name="Não (Há vagas)" sourceRef="Gateway_IsBusFull" targetRef="Task_ParkAtStop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isFull == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ParkToOpenDoors" sourceRef="Task_ParkAtStop" targetRef="Task_OpenFrontDoors" />
    <bpmn:sequenceFlow id="Flow_DoorsToBoard" sourceRef="Task_OpenFrontDoors" targetRef="Task_BoardBus" />
    <bpmn:sequenceFlow id="Flow_BoardToPayGateway" sourceRef="Task_BoardBus" targetRef="Gateway_PaymentMethod" />

    <bpmn:sequenceFlow id="Flow_PayByCard" name="Cartão Eletrônico" sourceRef="Gateway_PaymentMethod" targetRef="Task_TapSmartCard">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method == 'card'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CashEntryToPay" sourceRef="Gateway_CashEntry" targetRef="Task_PayWithCash" />
    <bpmn:sequenceFlow id="Flow_ReleaseToUnlock" sourceRef="Gateway_TurnstileRelease" targetRef="Task_UnlockTurnstile" />
    <bpmn:sequenceFlow id="Flow_PayByCash" name="Dinheiro" sourceRef="Gateway_PaymentMethod" targetRef="Gateway_CashEntry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method == 'cash'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_TapToValidate" sourceRef="Task_TapSmartCard" targetRef="Task_ValidateCardBalance" />
    <bpmn:sequenceFlow id="Flow_ValidateToBalanceGateway" sourceRef="Task_ValidateCardBalance" targetRef="Gateway_CardBalanceCheck" />
    
    <bpmn:sequenceFlow id="Flow_BalanceSufficient" name="Saldo suficiente" sourceRef="Gateway_CardBalanceCheck" targetRef="Task_DeductFare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cardBalance &gt;= fare}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DeductToUnlock" sourceRef="Task_DeductFare" targetRef="Gateway_TurnstileRelease" />

    <bpmn:sequenceFlow id="Flow_BalanceInsufficient" name="Saldo insuficiente" sourceRef="Gateway_CardBalanceCheck" targetRef="Task_AlertInsufficientBalance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cardBalance &lt; fare}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AlertToFallback" sourceRef="Task_AlertInsufficientBalance" targetRef="Gateway_FallbackCash" />

    <bpmn:sequenceFlow id="Flow_HasFallbackCash" name="Possui dinheiro" sourceRef="Gateway_FallbackCash" targetRef="Gateway_CashEntry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasCash == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoFallbackCash" name="Sem dinheiro" sourceRef="Gateway_FallbackCash" targetRef="End_LeftNoFunds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasCash == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_PayToReceiveCash" sourceRef="Task_PayWithCash" targetRef="Task_ReceiveCash" />
    <bpmn:sequenceFlow id="Flow_ReceiveToChangeGateway" sourceRef="Task_ReceiveCash" targetRef="Gateway_HasChange" />

    <bpmn:sequenceFlow id="Flow_ChangeAvailable" name="Troco OK ou valor exato" sourceRef="Gateway_HasChange" targetRef="Task_CalculateAndReturnChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasChange == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChangeToAuthorize" sourceRef="Task_CalculateAndReturnChange" targetRef="Task_AuthorizeTurnstileManual" />
    <bpmn:sequenceFlow id="Flow_AuthorizeToUnlock" sourceRef="Task_AuthorizeTurnstileManual" targetRef="Gateway_TurnstileRelease" />

    <bpmn:sequenceFlow id="Flow_ChangeUnavailable" name="Sem troco disponível" sourceRef="Gateway_HasChange" targetRef="Task_UnableToGiveChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasChange == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoChangeToEnd" sourceRef="Task_UnableToGiveChange" targetRef="End_LeftNoFunds" />

    <bpmn:sequenceFlow id="Flow_UnlockToPass" sourceRef="Task_UnlockTurnstile" targetRef="Task_PassTurnstile" />
    <bpmn:sequenceFlow id="Flow_PassToCloseDoors" sourceRef="Task_PassTurnstile" targetRef="Task_CloseDoors" />
    <bpmn:sequenceFlow id="Flow_DoorsToResume" sourceRef="Task_CloseDoors" targetRef="Task_ResumeRoute" />
    <bpmn:sequenceFlow id="Flow_ResumeToSeatCheck" sourceRef="Task_ResumeRoute" targetRef="Gateway_SeatAvailable" />

    <bpmn:sequenceFlow id="Flow_SeatFreeYes" name="Sim" sourceRef="Gateway_SeatAvailable" targetRef="Task_SitInSeat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasFreeSeat == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SitToMerge" sourceRef="Task_SitInSeat" targetRef="Gateway_MergePosture" />

    <bpmn:sequenceFlow id="Flow_SeatFreeNo" name="Não" sourceRef="Gateway_SeatAvailable" targetRef="Task_TravelStanding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasFreeSeat == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StandToMerge" sourceRef="Task_TravelStanding" targetRef="Gateway_MergePosture" />

    <bpmn:sequenceFlow id="Flow_MergeToPressButton" sourceRef="Gateway_MergePosture" targetRef="Task_PressStopButton" />
    <bpmn:sequenceFlow id="Flow_ButtonToTrigger" sourceRef="Task_PressStopButton" targetRef="Task_TriggerStopIndicator" />
    <bpmn:sequenceFlow id="Flow_TriggerToStop" sourceRef="Task_TriggerStopIndicator" targetRef="Task_StopAtDestination" />
    <bpmn:sequenceFlow id="Flow_StopToOpenRear" sourceRef="Task_StopAtDestination" targetRef="Task_OpenRearDoors" />
    <bpmn:sequenceFlow id="Flow_OpenRearToDisembark" sourceRef="Task_OpenRearDoors" targetRef="Task_DisembarkBus" />
    <bpmn:sequenceFlow id="Flow_DisembarkToEnd" sourceRef="Task_DisembarkBus" targetRef="End_TripCompleted" />

  </bpmn:process>
