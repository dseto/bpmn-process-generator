<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deliberately broken reference file: every error below exists to make one lint
  rule fire, so `bpmn_tool.py validate references/example-broken.bpmn` shows what
  a rejected diagram looks like. Do NOT "fix" it.

    dangling-flow-ref        Flow_1 targets Task_DoesNotExist
    unreachable-node         Task_ReviewExpense never receives a real flow
                             (keep it that way: nothing may target it)
    flow-refs-mismatch       Task_ReviewExpense declares <incoming>Flow_1</incoming> anyway
    start-has-incoming       Flow_Restart loops back into the start event
    end-has-outgoing         Flow_AfterEnd leaves an end event
    default-flow-invalid     Gateway_Approved names a default flow that is not its own
    boundary-invalid         Boundary_NoHost has no attachedToRef
    lane-coverage-duplicate  Task_ProcessPayment is listed in both lanes
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_ExpenseApproval" name="Expense approval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Start_ExpenseSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance" name="Finance">
        <bpmn:flowNodeRef>Task_ProcessPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyRejection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ExpenseSubmitted" name="Expense submitted">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewExpense" name="Manager reviews expense">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_2">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ProcessPayment" name="Finance processes payment">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NotifyRejection" name="Notify employee of rejection">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_NoHost" name="Deadline">
      <bpmn:outgoing>Flow_Restart</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_PaymentProcessed" name="Payment processed">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterEnd</bpmn:outgoing>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ExpenseRejected" name="Expense rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_ExpenseSubmitted" targetRef="Task_DoesNotExist" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReviewExpense" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_ProcessPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Approved" targetRef="Task_NotifyRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ProcessPayment" targetRef="End_PaymentProcessed" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_NotifyRejection" targetRef="End_ExpenseRejected" />
    <bpmn:sequenceFlow id="Flow_Restart" sourceRef="Boundary_NoHost" targetRef="Start_ExpenseSubmitted" />
    <bpmn:sequenceFlow id="Flow_AfterEnd" sourceRef="End_PaymentProcessed" targetRef="Task_ProcessPayment" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ExpenseApproval">
      <bpmndi:BPMNShape id="Start_ExpenseSubmitted_di" bpmnElement="Start_ExpenseSubmitted">
        <omgdc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewExpense_di" bpmnElement="Task_ReviewExpense">
        <omgdc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved">
        <omgdc:Bounds x="395" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <omgdc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRejection_di" bpmnElement="Task_NotifyRejection">
        <omgdc:Bounds x="500" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_NoHost_di" bpmnElement="Boundary_NoHost">
        <omgdc:Bounds x="322" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PaymentProcessed_di" bpmnElement="End_PaymentProcessed">
        <omgdc:Bounds x="660" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ExpenseRejected_di" bpmnElement="End_ExpenseRejected">
        <omgdc:Bounds x="660" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="188" y="120" />
        <omgdi:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="340" y="120" />
        <omgdi:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <omgdi:waypoint x="445" y="120" />
        <omgdi:waypoint x="500" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <omgdi:waypoint x="420" y="145" />
        <omgdi:waypoint x="420" y="240" />
        <omgdi:waypoint x="500" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="600" y="120" />
        <omgdi:waypoint x="660" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="600" y="240" />
        <omgdi:waypoint x="660" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Restart_di" bpmnElement="Flow_Restart">
        <omgdi:waypoint x="340" y="278" />
        <omgdi:waypoint x="170" y="278" />
        <omgdi:waypoint x="170" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AfterEnd_di" bpmnElement="Flow_AfterEnd">
        <omgdi:waypoint x="678" y="102" />
        <omgdi:waypoint x="678" y="40" />
        <omgdi:waypoint x="550" y="40" />
        <omgdi:waypoint x="550" y="80" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
